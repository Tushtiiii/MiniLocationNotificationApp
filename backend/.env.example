# Server Configuration
PORT=5000

# Firebase Cloud Messaging (FCM) Service Account Configuration
# Option 1: Discrete Environment Variables (Recommended for production & hosted environments)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to service account JSON file (relative to backend folder)
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/serviceAccountKey.json

# Option 3: Raw service account JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "..."}'
